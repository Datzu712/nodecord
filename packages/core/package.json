{
    "name": "@nodecord/core",
    "version": "0.2.0",
    "type": "module",
    "types": "./dist/index.d.ts",
    "main": "./dist/index.js",
    "scripts": {
        "dev": "tsup --watch",
        "build": "tsup",
        "lint": "eslint . --ext .ts,.tsx",
        "typecheck": "tsc --noEmit"
    },
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.cjs"
        }
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Datzu712/nodecord.git"
    },
    "author": "Datzu712",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/Datzu712/nodecord/issues"
    },
    "homepage": "https://github.com/Datzu712/nodecord#readme",
    "publishConfig": {
        "access": "public"
    },
    "contributors": [
        {
            "name": "Datzu712",
            "url": "https://github.com/Datzu712",
            "author": true
        }
    ],
    "keywords": [
        "discord",
        "discord-bot",
        "framework",
        "typescript",
        "dependency-injection",
        "di",
        "decorators",
        "modular",
        "inversify",
        "slash-commands",
        "interceptors",
        "nestjs"
    ],
    "devDependencies": {
        "discord-api-types": "^0.38.48",
        "tsup": "8.5.1",
        "typescript": "6.0.3"
    },
    "dependencies": {
        "inversify": "^8.1.0"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ]
}
