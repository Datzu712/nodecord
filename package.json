{
    "name": "nodecord",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "turbo run build",
        "dev": "turbo run dev",
        "lint": "oxlint --type-aware packages",
        "test": "vitest run",
        "format": "oxfmt",
        "typecheck": "turbo run typecheck",
        "prepare": "husky",
        "changeset": "changeset",
        "version-packages": "changeset version",
        "release": "changeset publish",
        "format:check": "oxfmt --check"
    },
    "devDependencies": {
        "@changesets/cli": "^2.31.1",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@turbo/gen": "^2.10.7",
        "@types/node": "^25.9.5",
        "husky": "^9.1.7",
        "lint-staged": "^17.2.0",
        "nodemon": "^3.1.14",
        "oxfmt": "^0.60.0",
        "oxlint": "^1.75.0",
        "oxlint-tsgolint": "^7.0.2001",
        "tsdown": "^0.22.14",
        "tsx": "^4.23.1",
        "turbo": "^2.10.7",
        "typescript": "6.0.3",
        "vitest": "^4.1.10",
        "wrangler": "^4.114.0"
    },
    "packageManager": "pnpm@11.17.0",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "@swc/core": "^1.15.46",
        "reflect-metadata": "^0.2.2"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@swc/core",
            "core-js",
            "esbuild"
        ]
    }
}
